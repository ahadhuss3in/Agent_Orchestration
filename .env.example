# Copy this file to .env and fill in your own values:
#
#   cp .env.example .env
#
# .env is gitignored; never commit real keys. Every name below is read in
# app/config.py, which is the single place the rest of the code gets config from.

# --- LLM providers ---------------------------------------------------------
# Extraction uses an OpenAI-compatible client pointed at CUSTOM_* below.
# Agent chat uses DEEPSEEK_*. Swapping either is an .env change, not a code change.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GROQ_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Chars of source text packed into one extraction call (roughly 4 chars/token).
EXTRACT_MAX_CHARS=12000

# --- Web context (Tavily, through the MCP server) --------------------------
TAVILY_API_KEY=

# --- Vector store (Qdrant) -------------------------------------------------
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
# Collection name is fixed in app/config.py (QDRANT_COLLECTION). It is wiped and
# recreated on every run, so do not point this at a collection you care about.

# --- Embeddings ------------------------------------------------------------
# "gemini" or "custom". A failed probe falls back to a local sentence-transformer.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

# Used when EMBEDDING_PROVIDER=custom (any OpenAI-compatible /embeddings endpoint).
CUSTOM_EMBEDDING_BASE_URL=
CUSTOM_EMBEDDING_API_KEY=
CUSTOM_EMBEDDING_MODEL=
CUSTOM_EMBEDDING_MAX_CHARS=900

# --- Knowledge graph (Neo4j) ----------------------------------------------
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- Agent layer -----------------------------------------------------------
# Top-N entities by relationship count become the promotable candidate pool.
AGENT_POOL_SIZE=10
AGENT_CHAT_TOP_K=8
AGENT_CHAT_MEMORY=40

# --- Social context (optional) --------------------------------------------
# Empty SOCIAL_PLATFORMS makes the social node a no-op pass-through.
SOCIAL_PLATFORMS=
SOCIAL_QUERY_TYPE=keyword
SOCIAL_POSTS_PER_PLATFORM=50
SOCIAL_MAX_POSTS=2000
SOCIAL_MAX_COST_USD=20
SOCIAL_FETCH_TIMEOUT_SECONDS=120

# X official API v2
X_BEARER_TOKEN=

# Bright Data Web Scraper API (Instagram / Facebook). dataset id, discovery mode
# and seed URL are per-platform values from your account's Control Panel:
#   SOCIAL_BRIGHTDATA_DATASET_X / _INSTAGRAM / _FACEBOOK
#   SOCIAL_BRIGHTDATA_DISCOVER_BY_X / _INSTAGRAM / _FACEBOOK
#   SOCIAL_BRIGHTDATA_SEED_URL_X / _INSTAGRAM / _FACEBOOK
BRIGHTDATA_API_TOKEN=
SOCIAL_BRIGHTDATA_DATASET_X=
SOCIAL_BRIGHTDATA_DATASET_INSTAGRAM=
SOCIAL_BRIGHTDATA_DATASET_FACEBOOK=
SOCIAL_BRIGHTDATA_DISCOVER_BY_X=
SOCIAL_BRIGHTDATA_DISCOVER_BY_INSTAGRAM=
SOCIAL_BRIGHTDATA_DISCOVER_BY_FACEBOOK=
SOCIAL_BRIGHTDATA_SEED_URL_X=
SOCIAL_BRIGHTDATA_SEED_URL_INSTAGRAM=
SOCIAL_BRIGHTDATA_SEED_URL_FACEBOOK=
SOCIAL_BRIGHTDATA_USD_PER_RECORD=0.0015
SOCIAL_PROVIDER_MAX_WAIT_SECONDS=180

# --- Observability ---------------------------------------------------------
# Optional. If unset, Logfire is configured without a token and only logs locally.
LOGFIRE_TOKEN=
